# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Canonical origin for canonical tags, hreflang, sitemap and JSON-LD.
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
# Production is set to the apex (no www) in the Vercel dashboard; www and the
# .vercel.app hosts 308 to it, so this value is what the canonical tags claim.
NEXT_PUBLIC_SITE_URL=https://raqmatch.com

# Affiliate program (all optional — with none set, outbound links stay plain
# merchant URLs and the affiliate disclosure is hidden). Use EITHER:
#   1. a tracking param appended to the merchant URL
AFFILIATE_PARAM=
AFFILIATE_ID=
#   2. or a network wrapper URL, where {url} receives the encoded merchant URL
AFFILIATE_URL_TEMPLATE=

# Google AdSense (all optional — with none set, no ad script loads, no slots
# render and no consent banner appears).
#
# These are NEXT_PUBLIC_ because the <ins> element and the loader script run in
# the browser, which means they are INLINED AT BUILD TIME: changing a value in
# the Vercel dashboard does nothing until the next build (`vercel redeploy`).
#
# The publisher id, as shown in AdSense ("ca-pub-…"). Setting this alone enables
# the loader, /ads.txt and the consent banner.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
#
# One ad unit id per placement. A placement with no id renders nothing, so you
# can roll them out one at a time. Create these as "Display" units in AdSense.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=
NEXT_PUBLIC_ADSENSE_SLOT_RACQUET=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
#
# /quiz and /privacy never load the ad library at all, regardless of the above —
# see AD_FREE_PREFIXES in src/lib/ads.ts.
#
# Turn Auto Ads OFF in the AdSense dashboard. Left on, Google injects units of its
# own (anchors, vignettes, in-content) into every page that loads the library,
# which overrides the placement choices above everywhere except the routes that
# block the script entirely.

# Address published on the privacy policy for LGPD requests. Defaults to
# contato@raqmatch.com — set up forwarding for it before ads go live, since an
# unreachable contact fails both LGPD art. 18 and AdSense review.
NEXT_PUBLIC_CONTACT_EMAIL=

# Postgres. Optional: without it the app runs exactly as before — analytics
# become no-ops and rate limiting falls back to an in-process counter.
#
# In .env.local this must point at your LOCAL database (`npm run db:up`), never
# at production: dev traffic mixed into real analytics makes the data useless.
DATABASE_URL=postgresql://postgres:dev@localhost:55432/findmyracquet
#
# Production's connection string lives in .env.production.local instead, read
# only by `npm run db:migrate:prod`. Use Neon's DIRECT string there; the app on
# Vercel gets the POOLED one (the "-pooler" host) via the Vercel dashboard.

# Rate limits for /api/recommend (each call costs an Anthropic request).
# Defaults: 10 per IP per hour, 500 globally per day.
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400
