# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Canonical origin for canonical tags, hreflang, sitemap and JSON-LD.
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
# Set this once a custom domain exists.
NEXT_PUBLIC_SITE_URL=https://findmyracquet.com

# Affiliate program (all optional — with none set, outbound links stay plain
# merchant URLs and the affiliate disclosure is hidden). Use EITHER:
#   1. a tracking param appended to the merchant URL
AFFILIATE_PARAM=
AFFILIATE_ID=
#   2. or a network wrapper URL, where {url} receives the encoded merchant URL
AFFILIATE_URL_TEMPLATE=

# Postgres. Optional: without it the app runs exactly as before — analytics
# become no-ops and rate limiting falls back to an in-process counter.
#
# In .env.local this must point at your LOCAL database (`npm run db:up`), never
# at production: dev traffic mixed into real analytics makes the data useless.
DATABASE_URL=postgresql://postgres:dev@localhost:55432/findmyracquet
#
# Production's connection string lives in .env.production.local instead, read
# only by `npm run db:migrate:prod`. Use Neon's DIRECT string there; the app on
# Vercel gets the POOLED one (the "-pooler" host) via the Vercel dashboard.

# Rate limits for /api/recommend (each call costs an Anthropic request).
# Defaults: 10 per IP per hour, 500 globally per day.
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400
