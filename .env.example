# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# Canonical origin for canonical tags, hreflang, sitemap and JSON-LD.
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
# Set this once a custom domain exists.
NEXT_PUBLIC_SITE_URL=https://findmyracquet.com

# Affiliate program (all optional — with none set, outbound links stay plain
# merchant URLs and the affiliate disclosure is hidden). Use EITHER:
#   1. a tracking param appended to the merchant URL
AFFILIATE_PARAM=
AFFILIATE_ID=
#   2. or a network wrapper URL, where {url} receives the encoded merchant URL
AFFILIATE_URL_TEMPLATE=
